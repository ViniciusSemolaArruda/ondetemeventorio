{
  "expo": {
    "name": "Onde Tem Evento Rio",
    "slug": "ondetemeventorio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo01.png",

    "splash": {
      "image": "./assets/icons/pin-1200x1200.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },

    "android": {
      "package": "com.capadocia.ondetemeventorio",
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground-432.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": { "apiKey": "AIzaSyByyTBGR1rWcchXSR59JOVVG2IszfmpeVI" }
      },
      "jsEngine": "hermes"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/pin-1200x1200.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "2.0.21",
            "packagingOptions": { "exclude": ["META-INF/*"] }
          }
        }
      ]
    ],

    "owner": "viniciusarruda",
    "extra": {
      "API_BASE_URL": "https://www.ondetemeventorio.com.br",
      "GOOGLE_WEB_CLIENT_ID": "130486548338-89l6lucgtp5670uvu855dndetfiq8eo6.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID_LOCAL": "130486548338-32g4b5od7fjv54vsc2ja2dus03oh2o33.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID_PLAY": "130486548338-2um8iak2hdo86u80vdfo9jblfi6pagvi.apps.googleusercontent.com",
      "router": {},
      "eas": { "projectId": "31fd7ad0-f649-4047-a9d9-f8ebd6e675d8" }
    }
  }
}
