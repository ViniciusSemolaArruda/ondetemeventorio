{
  "expo": {
    "name": "Onde Tem Evento Rio",
    "slug": "ondetemeventorio",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icons/pin.png",

    "scheme": "ondetemeventorio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "SUA_CHAVE_GOOGLE_MAPS_AQUI"
      }
    },

    "android": {
      "package": "com.capadocia.ondetemeventorio",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/pin.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyByyTBGR1rWcchXSR59JOVVG2IszfmpeVI"
        }
      }
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],

    "experiments": { "typedRoutes": true },
    "owner": "viniciusarruda",

    "extra": {
      "API_BASE_URL": "https://www.ondetemeventorio.com.br",
      "GOOGLE_WEB_CLIENT_ID": "130486548338-89l6lucgtp5670uvu855dndetfiq8eo6.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID_LOCAL": "130486548338-32g4b5od7fjv54vsc2ja2dus03oh2o33.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID_PLAY": "130486548338-2um8iak2hdo86u80vdfo9jblfi6pagvi.apps.googleusercontent.com",
      "router": {},
      "eas": { "projectId": "31fd7ad0-f649-4047-a9d9-f8ebd6e675d8" }
    }
  }
}
