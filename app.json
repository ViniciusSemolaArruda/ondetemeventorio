{
  "expo": {
    "name": "ondetemeventorio",
    "slug": "ondetemeventorio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ondetemeventorio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.capadocia.ondetemeventorio"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "viniciusarruda",
    "extra": {
      "API_BASE_URL": "https://ondetemeventorio.vercel.app",
      "GOOGLE_CLIENT_ID": "130486548338-89l6lucgtp5670uvu855dndetfiq8eo6.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID": "130486548338-i7m9ts9maegg20to0ji86vau48p5rdad.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "31fd7ad0-f649-4047-a9d9-f8ebd6e675d8"
      }
    }
  }
}
